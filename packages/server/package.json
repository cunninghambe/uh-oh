{
  "name": "@uh-oh/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @uh-oh/types build && tsc -p tsconfig.build.json",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/multipart": "10.0.0",
    "@uh-oh/mcp": "workspace:*",
    "@uh-oh/types": "workspace:*",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "jose": "5.10.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "source-map": "0.7.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.0",
    "vitest": "4.1.6"
  }
}
